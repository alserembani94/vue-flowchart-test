{
  "name": "flow-nodes",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.23.2 || ^24.18.1 || >=26.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "vue-tsc -b",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.103.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
